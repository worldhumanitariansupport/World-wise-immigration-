<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>World Wise Immigration Agency</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      color: #172033;
      background: #f7f9fc;
      line-height: 1.6;
    }

    /* NAVIGATION */
    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255,255,255,0.96);
      box-shadow: 0 2px 15px rgba(0,0,0,0.08);
      padding: 15px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 21px;
      font-weight: bold;
      color: #123b70;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 28px;
    }

    nav a {
      text-decoration: none;
      color: #172033;
      font-weight: 600;
    }

    nav a:hover {
      color: #1769aa;
    }

    /* HOME */
    .hero {
      min-height: 100vh;
      padding: 150px 8% 100px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(rgba(7, 28, 58, 0.63), rgba(7, 28, 58, 0.63)),
        url("https://images.unsplash.com/photo-1521292270410-a8c4d716d518?auto=format&fit=crop&w=2000&q=85")
        center/cover no-repeat;
      color: white;
    }

    .hero-content {
      max-width: 720px;
    }

    .hero h1 {
      font-size: clamp(42px, 6vw, 72px);
      line-height: 1.08;
      margin-bottom: 25px;
    }

    .hero p {
      font-size: 20px;
      max-width: 650px;
      margin-bottom: 35px;
      color: #eef5ff;
    }

    .btn {
      display: inline-block;
      padding: 15px 28px;
      border-radius: 7px;
      background: #1769aa;
      color: white;
      text-decoration: none;
      font-weight: bold;
      border: none;
      cursor: pointer;
      font-size: 16px;
    }

    .btn:hover {
      background: #0d568f;
    }

    .btn-light {
      background: white;
      color: #123b70;
      margin-left: 10px;
    }

    /* GENERAL SECTIONS */
    section {
      padding: 100px 8%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 55px;
    }

    .section-title h2 {
      font-size: 40px;
      color: #123b70;
      margin-bottom: 12px;
    }

    .section-title p {
      color: #687386;
      max-width: 700px;
      margin: auto;
    }

    /* ABOUT */
    .about {
      background: white;
    }

    .about-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }

    .about-image {
      min-height: 430px;
      border-radius: 15px;
      background:
        linear-gradient(rgba(10,45,85,.25), rgba(10,45,85,.25)),
        url("https://images.unsplash.com/photo-1494587416117-f102a2ac0a8d?auto=format&fit=crop&w=1200&q=80")
        center/cover;
    }

    .about-text h3 {
      font-size: 30px;
      color: #123b70;
      margin-bottom: 20px;
    }

    .about-text p {
      margin-bottom: 18px;
      color: #566174;
    }

    /* SERVICES */
    .services {
      background: #f7f9fc;
    }

    .cards {
      max-width: 1150px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .card {
      background: white;
      padding: 35px 28px;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0,0,0,.06);
    }

    .card h3 {
      color: #123b70;
      margin-bottom: 12px;
    }

    .card p {
      color: #687386;
    }

    /* JOBS */
    .jobs {
      background: white;
    }

    .application-box {
      max-width: 850px;
      margin: auto;
      background: #fff;
      padding: 45px;
      border-radius: 15px;
      box-shadow: 0 10px 40px rgba(0,0,0,.08);
    }

    .form-group {
      margin-bottom: 22px;
    }

    label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
      color: #25334a;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 14px;
      border: 1px solid #ccd4df;
      border-radius: 7px;
      font-size: 16px;
      outline: none;
      background: white;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #1769aa;
    }

    textarea {
      min-height: 130px;
      resize: vertical;
    }

    .radio-group {
      display: flex;
      gap: 25px;
      margin-top: 8px;
    }

    .radio-option {
      display: flex;
      align-items: center;
      gap: 7px;
      font-weight: normal;
    }

    .radio-option input {
      width: auto;
    }

    /* SEARCHABLE JOB SELECT */
    .job-selector {
      position: relative;
    }

    .job-display {
      width: 100%;
      padding: 14px;
      border: 1px solid #ccd4df;
      border-radius: 7px;
      background: white;
      cursor: pointer;
      color: #667085;
    }

    .job-display.selected {
      color: #172033;
    }

    .job-menu {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: calc(100% + 5px);
      z-index: 50;
      background: white;
      border: 1px solid #ccd4df;
      border-radius: 8px;
      box-shadow: 0 10px 30px rgba(0,0,0,.12);
      overflow: hidden;
    }

    .job-search {
      border: none;
      border-bottom: 1px solid #ddd;
      border-radius: 0;
    }

    .job-list {
      max-height: 280px;
      overflow-y: auto;
    }

    .job-option {
      padding: 12px 15px;
      cursor: pointer;
    }

    .job-option:hover {
      background: #eef6ff;
    }

    .submit-btn {
      width: 100%;
      margin-top: 10px;
    }

    /* CONTACT */
    .contact {
      background: #123b70;
      color: white;
      text-align: center;
    }

    .contact h2 {
      font-size: 40px;
      margin-bottom: 20px;
    }

    .contact p {
      margin-bottom: 10px;
    }

    /* FOOTER */
    footer {
      background: #0b2749;
      color: white;
      text-align: center;
      padding: 25px;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 800px) {
      nav {
        padding: 14px 5%;
      }

      nav ul {
        gap: 12px;
      }

      nav a {
        font-size: 14px;
      }

      .logo {
        font-size: 16px;
      }

      .about-grid,
      .cards {
        grid-template-columns: 1fr;
      }

      .hero {
        padding-left: 6%;
        padding-right: 6%;
      }

      section {
        padding: 75px 6%;
      }

      .application-box {
        padding: 25px 20px;
      }

      .btn-light {
        margin-left: 0;
        margin-top: 10px;
      }
    }
  </style>
</head>

