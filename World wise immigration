  <!-- NAVIGATION -->
  <nav>
    <div class="logo">WORLD WISE IMMIGRATION</div>

    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#jobs">Jobs</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>


  <!-- HOME -->
  <section class="hero" id="home">
    <div class="hero-content">

      <h1>Your Gateway to Global Opportunities</h1>

      <p>
        World Wise Immigration Agency connects applicants
        with international employment opportunities and
        provides guidance throughout the application process.
      </p>

      <a href="#jobs" class="btn">Explore Jobs</a>
      <a href="#about" class="btn btn-light">About Us</a>

    </div>
  </section>


  <!-- ABOUT -->
  <section class="about" id="about">

    <div class="section-title">
      <h2>About World Wise Immigration</h2>
      <p>
        Helping people discover international opportunities
        and take the next step toward their career goals.
      </p>
    </div>

    <div class="about-grid">

      <div class="about-image"></div>

      <div class="about-text">

        <h3>Connecting People With Opportunities</h3>

        <p>
          World Wise Immigration Agency is focused on helping
          applicants explore employment opportunities abroad.
        </p>

        <p>
          Our platform makes it simple for applicants to view
          available positions, provide their information and
          submit an application for consideration.
        </p>

        <p>
          Browse our available opportunities below and find
          a position that matches your skills and experience.
        </p>

      </div>

    </div>

  </section>


  <!-- SERVICES -->
  <section class="services">

    <div class="section-title">
      <h2>Our Services</h2>
      <p>Professional support for applicants seeking international opportunities.</p>
    </div>

    <div class="cards">

      <div class="card">
        <h3>Job Opportunities</h3>
        <p>
          Explore a wide range of international employment
          opportunities across different industries.
        </p>
      </div>

      <div class="card">
        <h3>Application Support</h3>
        <p>
          Submit your details through our simple online
          application process.
        </p>
      </div>

      <div class="card">
        <h3>Immigration Guidance</h3>
        <p>
          Receive guidance throughout the relevant
          immigration and employment process.
        </p>
      </div>

    </div>

  </section>


  <!-- JOB APPLICATION -->
  <section class="jobs" id="jobs">

    <div class="section-title">

      <h2>Job Application</h2>

      <p>
        Select a job and complete your application details.
      </p>

    </div>


    <div class="application-box">

      <form id="applicationForm">

        <!-- JOB -->
        <div class="form-group">

          <label>Select Job *</label>

          <div class="job-selector">

            <div
              class="job-display"
              id="jobDisplay"
              onclick="toggleJobMenu()"
            >
              Select Job
            </div>

            <div class="job-menu" id="jobMenu">

              <input
                type="text"
                class="job-search"
                id="jobSearch"
                placeholder="Search jobs..."
                oninput="filterJobs()"
              >

              <div class="job-list" id="jobList"></div>

            </div>

          </div>

          <input type="hidden" id="selectedJob" required>

        </div>


        <!-- FULL NAME -->
        <div class="form-group">
          <label for="name">Full Name *</label>
          <input
            type="text"
            id="name"
            placeholder="Enter your full name"
            required
          >
        </div>


        <!-- PHONE -->
        <div class="form-group">
          <label for="phone">Phone / WhatsApp Number *</label>
          <input
            type="tel"
            id="phone"
            placeholder="+254..."
            required
          >
        </div>


        <!-- EMAIL -->
        <div class="form-group">
          <label for="email">Email Address *</label>
          <input
            type="email"
            id="email"
            placeholder="Enter your email"
            required
          >
        </div>


        <!-- COUNTRY -->
        <div class="form-group">
          <label for="country">Country of Residence *</label>
          <input
            type="text"
            id="country"
            placeholder="Enter your country"
            required
          >
        </div>


        <!-- NATIONALITY -->
        <div class="form-group">
          <label for="nationality">Nationality</label>
          <input
            type="text"
            id="nationality"
            placeholder="Enter your nationality"
          >
        </div>


        <!-- DATE OF BIRTH -->
        <div class="form-group">
          <label for="dob">Date of Birth</label>
          <input type="date" id="dob">
        </div>


        <!-- EDUCATION -->
        <div class="form-group">

          <label for="education">Highest Education Level</label>

          <select id="education">

            <option value="">Select education level</option>
            <option>Primary</option>
            <option>Secondary</option>
            <option>Certificate</option>
            <option>Diploma</option>
            <option>Degree</option>
            <option>Masters</option>
            <option>PhD</option>

          </select>

        </div>


        <!-- EXPERIENCE -->
        <div class="form-group">

          <label for="experience">Work Experience</label>

          <select id="experience">

            <option value="">Select experience</option>
            <option>No experience</option>
            <option>Less than 1 year</option>
            <option>1–2 years</option>
            <option>3–5 years</option>
            <option>6–10 years</option>
            <option>More than 10 years</option>

          </select>

        </div>


        <!-- CURRENT OCCUPATION -->
        <div class="form-group">

          <label for="occupation">Current Occupation</label>

          <input
            type="text"
            id="occupation"
            placeholder="What do you currently do?"
          >

        </div>


        <!-- CV -->
        <div class="form-group">

          <label>Do you have a CV? *</label>

          <div class="radio-group">

            <label class="radio-option">
              <input type="radio" name="cv" value="Yes" required>
              Yes
            </label>

            <label class="radio-option">
              <input type="radio" name="cv" value="No">
              No
            </label>

          </div>

        </div>


        <!-- PASSPORT -->
        <div class="form-group">

          <label>Do you have a valid passport? *</label>

          <div class="radio-group">

            <label class="radio-option">
              <input type="radio" name="passport" value="Yes" required>
              Yes
            </label>

            <label class="radio-option">
              <input type="radio" name="passport" value="No">
              No
            </label>

          </div>

        </div>


        <!-- ADDITIONAL INFORMATION -->
        <div class="form-group">

          <label for="message">Additional Information</label>

          <textarea
            id="message"
            placeholder="Tell us anything else you would like us to know..."
          ></textarea>

        </div>


        <!-- SUBMIT -->
        <button type="submit" class="btn submit-btn">
          Submit Application
        </button>

      </form>

    </div>

  </section>


  <!-- CONTACT -->
  <section class="contact" id="contact">

    <h2>Contact World Wise Immigration</h2>

    <p>
      For enquiries and application assistance, contact us.
    </p>

    <p>
      WhatsApp: +254 789 748 181
    </p>

  </section>


  <!-- FOOTER -->
  <footer>

    © 2026 World Wise Immigration Agency.
    All rights reserved.

  </footer>


